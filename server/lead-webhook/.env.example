# Copy to Cloudflare Worker secrets or local .dev.vars (never commit real values)

# Telegram Bot API — create bot via @BotFather, get chat_id via @userinfobot or getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# YouGile REST API v2 — Admin → Integrations → API key
# Column ID for "Лид" in project "Taneesh" on B2B sales board (copy from board URL or API)
YOUGILE_API_KEY=
YOUGILE_COLUMN_ID=

# Comma-separated origins allowed for CORS (GitHub Pages + local dev)
CORS_ORIGIN=https://timprodact.github.io,http://127.0.0.1:8080,http://localhost:8080
